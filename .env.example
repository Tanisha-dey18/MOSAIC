# ---------- Backend (FastAPI) ----------
# Environment name: development | test | production
MOSAIC_ENV=development

# Database. PostgreSQL is the target database (docker-compose provides one).
# For a quick local run without Docker you may use SQLite instead:
#   DATABASE_URL=sqlite:///./storage/mosaic.db
DATABASE_URL=postgresql+psycopg2://mosaic:change-me@localhost:5432/mosaic
POSTGRES_USER=mosaic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mosaic

# Where MOSAIC stores processed features, model artifacts, uploads and reports.
STORAGE_DIR=./storage
# Root directory from which server-side datasets may be ingested (path traversal is blocked outside it).
DATASETS_DIR=./datasets

# Upload limits
MAX_UPLOAD_MB=200

# Comma-separated list of allowed browser origins (set to your Netlify URL in production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO

# ---------- Frontend (Vite) ----------
# Base URL of the deployed backend (no trailing slash). Must NOT be localhost in production.
VITE_API_BASE_URL=http://localhost:8000
